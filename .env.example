# Browserbase: https://browserbase.com/settings
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: a Browserbase context holding your logged-in cookies (create it with `pnpm login`)
BROWSERBASE_CONTEXT_ID=

# The model driving the assistant (plans the task, calls the tools).
# Default: DeepSeek V4.1 Flash (open weights, MIT) through OpenRouter: https://openrouter.ai/keys
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash
ASSISTANT_VISION=true

# Alternative: Claude. Comment out the three ASSISTANT_* lines above and set:
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5

# Alternative (experimental): a local model on Ollama, or any OpenAI-compatible server.
# ASSISTANT_BASE_URL=http://localhost:11434/v1
# ASSISTANT_MODEL=qwen3:30b-a3b
# ASSISTANT_VISION=false   # text-only models don't get the screenshot tool

# The model behind Stagehand's act/observe/extract. Without a key it runs on the
# Browserbase Model Gateway (billed to your Browserbase account).
STAGEHAND_MODEL=anthropic/claude-haiku-4-5
STAGEHAND_MODEL_API_KEY=
